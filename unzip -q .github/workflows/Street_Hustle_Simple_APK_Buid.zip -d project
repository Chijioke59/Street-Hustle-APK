name: Build Street Hustle APK

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Download project
        uses: actions/checkout@v4

      - name: Extract Street Hustle project
        run: |
          unzip -q Street_Hustle_Simple_APK_Build.zip -d project
          PROJECT=$(find project -name settings.gradle -printf '%h\n' | head -1)
          echo "PROJECT=$PROJECT" >> $GITHUB_ENV

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Build APK
        working-directory: ${{ env.PROJECT }}
        run: gradle :app:assembleDebug --no-daemon

      - name: Save APK
        uses: actions/upload-artifact@v4
        with:
          name: Street-Hustle-APK
          path: ${{ env.PROJECT }}/app/build/outputs/apk/debug/app-debug.apk
